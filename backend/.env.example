# PostgreSQL (used when running against the docker-compose service)
DATABASE_URL=postgresql+psycopg2://osint:osint@localhost:5432/osint

# For running tests / local dev without Postgres, uncomment the SQLite URL:
# DATABASE_URL=sqlite:///./osint.db

# --- Sources -----------------------------------------------------------
# Shodan API key (https://account.shodan.io). Leave empty for mock mode.
SHODAN_API_KEY=
SHODAN_MOCK=true

# Brave Search API key (paid tier, https://brave.com/search/api/).
BRAVE_SEARCH_API_KEY=

# Google Custom Search (free 100 queries/day, https://programmablesearchengine.google.com/).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# OpenDataBot API (paid) — for accurate Ukrainian company registry data.
OPENDATABOT_API_KEY=

# Google Maps Geocoding API key. Leave empty for mock mode.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MOCK=true

# WHOIS via RDAP (free, no key). Real lookups by default; set true for mock.
WHOIS_MOCK=false

# Telegram Bot API token. Leave empty for mock mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MOCK=true

# --- AI -----------------------------------------------------------------
# Provider: auto | ollama | claude | mock
AI_PROVIDER=auto

# Anthropic API key (Claude). Leave empty for mock AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MOCK=true

# Local models via Ollama (free, no key). Empty model = auto-detect first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Multimodal (vision) model for image analysis/verification (e.g. llava).
OLLAMA_VISION_MODEL=

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
